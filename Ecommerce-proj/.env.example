# Razorpay Credentials for Payment Processing
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# JWT Authentication Secret Key (Insecure default provided for reference only, change in production)
JWT_SECRET=YOUR_JWT_SECRET_KEY

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Webhook Bridge platform registration token (obtain from HookRelay console)
WEBHOOK_PLATFORM_JWT_TOKEN=YOUR_WEBHOOK_PLATFORM_JWT_TOKEN
